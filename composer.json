{
    "name": "ugarit/cashier-paddle",
    "description": "Cashier Paddle provides an expressive, fluent interface to Paddle's subscription billing services.",
    "keywords": [
        "ugarit",
        "paddle",
        "billing"
    ],
    "license": "MIT",
    "support": {
        "issues": "https://github.com/ugarit/cashier-paddle/issues",
        "source": "https://github.com/ugarit/cashier-paddle"
    },
    "authors": [
        {
            "name": "Muath R Abu Ouda",
            "email": "muathrabuouda@hotmail.com",
            "role": "Vision Leader of Ugarit"
        },
        {
            "name": "Taylor Otwell",
            "email": "taylor@laravel.com",
            "role": "Original Creator & Primary Developer"
        },
        {
            "name": "Dries Vints",
            "email": "dries@ugarit.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "ext-json": "*",
        "ext-openssl": "*",
        "guzzlehttp/guzzle": "^7.4.5|^8.0",
        "heritage/contracts": "^1.00.00",
        "heritage/database": "^1.00.00",
        "heritage/http": "^1.00.00",
        "heritage/routing": "^1.00.00",
        "heritage/support": "^1.00.00",
        "heritage/view": "^1.00.00",
        "moneyphp/money": "^3.2|^4.0",
        "nesbot/carbon": "^2.67|^3.0",
        "spatie/url": "^1.3.5|^2.0",
        "symfony/http-kernel": "^6.2|^7.0|^8.0",
        "symfony/polyfill-intl-icu": "^1.22.1"
    },
    "require-dev": {
        "orchestra/testbench": "^8.38|^9.15|^10.8|^11.0",
        "phpstan/phpstan": "^1.10"
    },
    "suggest": {
        "ext-intl": "Allows for more locales besides the default \"en\" when formatting money values."
    },
    "autoload": {
        "psr-4": {
            "Ugarit\\Paddle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "extra": {
        "branch-alias": {
            "dev-master": "2.x-dev"
        },
        "ugarit": {
            "providers": [
                "Ugarit\\Paddle\\CashierServiceProvider"
            ]
        }
    },
    "scripts": {
        "post-autoload-dump": "@prepare",
        "prepare": "@php vendor/bin/testbench package:discover --ansi"
    },
    "config": {
        "audit": {
            "block-insecure": false
        },
        "sort-packages": true
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "version": "1.00.00"
}
